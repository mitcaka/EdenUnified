// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  passwordHash  String
  name          String
  role          String         // OWNER, ADMIN, MEMBER, VIEWER
  isActive      Boolean        @default(true)
  discordUserId String?
  assignedTasks Task[]         @relation("TaskAssignee")
  reviewedTasks Task[]         @relation("TaskReviewer")
  activityLogs  ActivityLog[]
  comments      Comment[]
  progressUpdates TaskProgressUpdate[]
  newsPosts     NewsPost[]     @relation("NewsAuthor")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

model Task {
  id            String        @id @default(cuid())
  title         String
  description   String?
  status        String        @default("TODO") // BACKLOG, TODO, DOING, NEED_REVIEW, NEED_TEST, DONE, CANCELLED
  priority      String        @default("MEDIUM") // LOW, MEDIUM, HIGH
  category      String?
  evidenceUrl   String?
  dueDate       DateTime?
  pointEstimate Int           @default(0)
  pointActual   Int           @default(0)
  bonusPoint    Int           @default(0)
  penaltyPoint  Int           @default(0)
  pointReason   String?
  reopenedCount Int           @default(0)
  completedAt   DateTime?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId    String?
  assignee      User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reviewerId    String?
  reviewer      User?         @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  activityLogs  ActivityLog[]
  comments      Comment[]
  progressUpdates TaskProgressUpdate[]

  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actionType  String   // e.g. "STATUS_CHANGE", "ASSIGNEE_CHANGE"
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model TaskProgressUpdate {
  id          String   @id @default(cuid())
  taskId      String
  authorId    String
  content     String
  type        String   @default("PROGRESS") // PROGRESS, REVIEW_NOTE
  statusFrom  String?
  statusTo    String?
  evidenceUrls String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

// ===== CMS Models: Nội dung cho trang người chơi =====

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json
}

model NewsPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String    // HTML content
  coverImageUrl String?
  status        String    @default("draft") // draft, published
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  authorId      String?
  author        User?     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([slug])
}

model Page {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  content        String    // HTML content
  status         String    @default("draft") // draft, published
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
}

model RuleCategory {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
  rules       Rule[]
}

model Rule {
  id          Int          @id @default(autoincrement())
  title       String
  slug        String       @unique
  content     String
  severity    String       @default("info") // info, minor, major, critical
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(true)
  categoryId  Int
  category    RuleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model GuideCategory {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
  guides      Guide[]
}

model Guide {
  id            Int           @id @default(autoincrement())
  title         String
  slug          String        @unique
  excerpt       String
  content       String        // HTML content
  difficulty    String        @default("beginner") // beginner, intermediate, advanced
  coverImageUrl String?
  sortOrder     Int           @default(0)
  isPublished   Boolean       @default(true)
  categoryId    Int
  category      GuideCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model MediaItem {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  type         String   @default("image") // image, video
  mediaUrl     String
  thumbnailUrl String?
  tags         String?  // JSON string array, e.g. '["landscape","season-3"]'
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  seasonId     Int?
}

model Faq {
  id          Int     @id @default(autoincrement())
  question    String
  answer      String
  category    String  @default("General")
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

